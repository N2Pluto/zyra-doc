  "outfit_state_shape": {
    "note": "รูปแบบ state ที่หน้าบ้านถือ และเป็น payload ตอน Save · colors = channel global · slots.<slot> = null (ไม่ใส่) หรือ {id, colors?} · colors ในชิ้นมีเฉพาะ channel primary/secondary ที่ชิ้นนั้นใช้",
    "example": {
      "colors": { "skin": "base", "hair": "black", "eye": "teal" },
      "slots": {
        "body": { "id": "std" },
        "eyes": { "id": "classic" },
        "hair": { "id": "thai" },
        "facial_hair": null,
        "top": { "id": "hoodie", "colors": { "primary": "teal", "secondary": "white" } },
        "bottom": { "id": "pants", "colors": { "primary": "navy" } },
        "shoes": { "id": "sneaker", "colors": { "primary": "red" } },
        "hat": null,
        "glasses": null,
        "accessory": null,
        "costume": null
      }
    },
    "rules": [
      "slot ที่ required=true ห้ามเป็น null",
      "costume != null → ตอน save ให้ normalize: top และ bottom เป็น null (costume occupies)",
      "เลือก top หรือ bottom ใหม่ขณะใส่ costume → costume = null + toast 'ถอดชุด special ออกแล้ว'",
      "เปลี่ยนชิ้นใน slot เดิม → คง colors primary/secondary เดิมไว้ถ้าชิ้นใหม่ใช้ channel นั้น ไม่งั้นใช้ default_cloth",
      "ชิ้นที่ ch ว่าง → ไม่แสดง swatch สี แสดงข้อความ 'ชิ้นนี้ศิลปินวาดสีมาแล้ว เปลี่ยนสีไม่ได้'",
      "costume → ไม่แสดง swatch เลย แสดง 'ชุด special ใช้สีตามที่วาดมาเสมอ ไม่มีตัวเลือกสี'",
      "costume ที่หมดช่วง (until ผ่านแล้ว): คนที่ใส่อยู่ใส่ต่อได้ แต่เลือกใหม่ไม่ได้ (ข้อเสนอ ยังไม่ confirm — AvatarCustomization ข้อค้าง 5)"
    ]
  },

