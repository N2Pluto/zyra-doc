{
  "$schema_note": "Data contract สำหรับ module แต่งตัวละครฝั่ง user (member) · ดึงจาก prototype Zyra Avatar Studio (https://claude.ai/artifact/5CWTCN9yMtbQ4czt29FVty) · version 0.1 · 2026-10-21 · อ่านคู่กับ README.md ในโฟลเดอร์นี้",
  "version": "0.1.0",
  "status": "draft — ยังไม่ผ่าน PM/ศิลปิน · ค่าใน parts/palettes เป็นชุดตัวอย่างจาก prototype ไม่ใช่ของจริงบน server",
  "source": {
    "prototype": "https://claude.ai/artifact/5CWTCN9yMtbQ4czt29FVty",
    "spec": "zyra-doc/plan/[Module] Avatar & Accessories Management (Admin)/spec.md §5",
    "requirements": "zyra-doc/plan/[Module] Avatar & Accessories Management (Admin)/requirements.md"
  },

  "sheet": {
    "frame": { "width": 48, "height": 48 },
    "rows": ["down", "left", "right", "up"],
    "row_label_th": { "down": "ลง", "left": "ซ้าย", "right": "ขวา", "up": "ขึ้น" },
    "walk": {
      "file": "walk.png",
      "cols": 4,
      "cols_with_blink": 5,
      "size": "192x192",
      "size_with_blink": "240x192",
      "col_meaning": { "0": "walk", "1": "idle (ยืน)", "2": "walk", "3": "walk", "4": "blink (หลับตา) — optional" }
    },
    "sit": {
      "file": "sit.png",
      "cols": 4,
      "cols_with_blink": 5,
      "size": "192x192",
      "size_with_blink": "240x192",
      "col_meaning": { "0": "sitting-down 1", "1": "sitting-down 2", "2": "seated (นั่ง)", "3": "stand-up (ลุก)", "4": "blink while seated — optional" },
      "optional": true,
      "fallback": "ถ้าชิ้นไม่มี sit sheet ใช้เฟรมจาก walk sheet แทน"
    },
    "blink_fallback": "ชิ้นที่ไม่มีคอลัมน์ 4 (blink) → ใช้คอลัมน์ 1 ของ walk / คอลัมน์ 2 ของ sit แทน",
    "alpha_rule": "pixel ต้อง alpha = 0 หรือ 255 เท่านั้น (ห้ามโปร่งครึ่ง)",
    "format": "PNG, พื้นโปร่ง, 1 px = 1 px (ไม่ scale)"
  },

  "baked_output": {
    "note": "server ประกอบชุดตอน user กด Save → ได้ไฟล์ชุดนี้ต่อ user 1 คน · VO/ws รับ URL ต่อคนเหมือนเดิม",
    "path_pattern": "outfits/{outfit_hash}/",
    "files": [
      { "name": "walk.png", "size": "240x192", "cols": 5, "note": "server เติมคอลัมน์หลับตาให้เสมอ" },
      { "name": "sit.png", "size": "240x192", "cols": 5, "note": "server เติมคอลัมน์หลับตาให้เสมอ" },
      { "name": "thumb.png", "size": "TBD", "note": "prototype ไม่ระบุขนาด · thumbnail ใน UI ตัดจาก frame down/walk col 1" }
    ],
    "default_outfit_shared": "ชุด default ใช้ไฟล์เดียวกันทุก user ที่ยังไม่เคยแต่ง"
  },

  "thumbnail_crop": {
    "note": "วิธีตัด thumbnail ของ item card ใน prototype · อ้างอิงจาก frame down / walk / col 1 (ยืน) ขนาดเฟรม 48x48",
    "head_slots": { "crop": { "x": 9, "y": 0, "w": 30, "h": 28 }, "scale": 3 },
    "body_slots": { "crop": { "x": 8, "y": 0, "w": 32, "h": 45 }, "scale": 2 }
  },

  "render_order": ["body", "eyes", "bottom", "shoes", "top", "costume", "facial_hair", "accessory", "hair", "glasses", "hat"],

  "slots": [
    { "id": "body",        "name_th": "ตัว",           "name_en": "Body",        "icon": "person-standing", "required": true,  "head": false, "color_channels": ["skin"],                         "note": "base character ตัวเดียว เลือกได้แค่สีผิว" },
    { "id": "eyes",        "name_th": "ตา",            "name_en": "Eyes",        "icon": "eye",             "required": true,  "head": true,  "color_channels": ["eye", "skin", "hair"],          "note": "ชิ้นเดียวที่มีคอลัมน์ blink (5 คอลัมน์)" },
    { "id": "hair",        "name_th": "ผม",            "name_en": "Hair",        "icon": "scissors",        "required": false, "head": true,  "color_channels": ["hair"] },
    { "id": "facial_hair", "name_th": "หนวด",          "name_en": "Facial hair", "icon": "smile",           "required": false, "head": true,  "color_channels": ["hair"],                         "note": "ใช้สีผมร่วมกับ hair เสมอ" },
    { "id": "top",         "name_th": "เสื้อ",          "name_en": "Top",         "icon": "shirt",           "required": true,  "head": false, "color_channels": ["primary", "secondary", "skin"] },
    { "id": "bottom",      "name_th": "กางเกง",        "name_en": "Bottom",      "icon": "columns-2",       "required": true,  "head": false, "color_channels": ["primary", "secondary"] },
    { "id": "shoes",       "name_th": "รองเท้า",       "name_en": "Shoes",       "icon": "footprints",      "required": false, "head": false, "color_channels": ["primary", "secondary"] },
    { "id": "hat",         "name_th": "หมวก",          "name_en": "Hat",         "icon": "crown",           "required": false, "head": true,  "color_channels": ["primary", "secondary"] },
    { "id": "glasses",     "name_th": "แว่น",          "name_en": "Glasses",     "icon": "glasses",         "required": false, "head": true,  "color_channels": ["primary"] },
    { "id": "accessory",   "name_th": "เครื่องประดับ", "name_en": "Accessory",   "icon": "gem",             "required": false, "head": false, "color_channels": ["primary", "secondary"] },
    { "id": "costume",     "name_th": "ชุด Special",   "name_en": "Special",     "icon": "sparkles",        "required": false, "head": false, "color_channels": [],                               "occupies": ["top", "bottom"], "note": "ทับเสื้อ+กางเกง · ใช้สีตามไฟล์ทั้งชิ้น ไม่มีตัวเลือกสี · มีช่วงเวลาเปิด/ปิด (until) · เลือก top/bottom ใหม่ = ถอด costume อัตโนมัติ" }
  ],

