  "randomize": {
    "note": "ปุ่ม 'สุ่ม' ใน prototype",
    "optional_slot_skip_chance": 0.45,
    "costume_chance": 0.12,
    "exclude_special_palettes": true
  },

  "animation": {
    "tick_ms": 125,
    "walk": { "sheet": "walk", "cols": [0, 1, 2, 3], "note": "วนทุก tick" },
    "stand": { "sheet": "walk", "col": 1, "blink_col": 4 },
